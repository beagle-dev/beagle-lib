::
:: windows script to create BeagleCUDASpectral_kernels.h, the counterpart of make_cuda_spectral_kernels.sh:
:: the kernels of createCUDAKernels.bat compiled with CUDA_SPECTRAL, which makes kernels4.cu and kernelsX.cu
:: include the spectral kernels (kernelsSpectralIfDef4.cu and kernelsSpectralIfDef.cu)
:: The temporary files are tmp_spectral_kernels*, which createCUDAKernels.bat (del tmp_kernels*) leaves alone
:: when both run at once
::

echo // DO NOT EDIT -- autogenerated file -- edit kernels4.cu instead > tmp_spectral_kernels_sp_4.cu
echo #define STATE_COUNT 4 >> tmp_spectral_kernels_sp_4.cu
type kernels4.cu >> tmp_spectral_kernels_sp_4.cu
nvcc.exe -o tmp_spectral_kernels_sp_4.ptx -ptx -arch compute_60 -I../../.. -DCUDA -DCUDA_SPECTRAL -O3 -m64 tmp_spectral_kernels_sp_4.cu || exit /b 1

FOR %%G IN (16 32 48 64 80 128 192 256) DO (

echo // DO NOT EDIT -- autogenerated file -- edit kernelsX.cu instead > tmp_spectral_kernels_sp_%%G.cu
echo #define STATE_COUNT %%G >> tmp_spectral_kernels_sp_%%G.cu
type kernelsX.cu >> tmp_spectral_kernels_sp_%%G.cu
nvcc.exe -o tmp_spectral_kernels_sp_%%G.ptx -ptx -arch compute_60 -I../../.. -DCUDA -DCUDA_SPECTRAL -O3 -m64 tmp_spectral_kernels_sp_%%G.cu || exit /b 1

)

echo // DO NOT EDIT -- autogenerated file -- edit kernels4.cu instead > tmp_spectral_kernels_dp_4.cu
echo #define STATE_COUNT 4 >> tmp_spectral_kernels_dp_4.cu
echo #define DOUBLE_PRECISION >> tmp_spectral_kernels_dp_4.cu
type kernels4.cu >> tmp_spectral_kernels_dp_4.cu
nvcc.exe -o tmp_spectral_kernels_dp_4.ptx -ptx -arch compute_60 -I../../.. -DCUDA -DCUDA_SPECTRAL -O3 -m64 tmp_spectral_kernels_dp_4.cu || exit /b 1

FOR %%G IN (16 32 48 64 80 128 192 256) DO (

echo // DO NOT EDIT -- autogenerated file -- edit kernelsX.cu instead > tmp_spectral_kernels_dp_%%G.cu
echo #define STATE_COUNT %%G >> tmp_spectral_kernels_dp_%%G.cu
echo #define DOUBLE_PRECISION >> tmp_spectral_kernels_dp_%%G.cu
type kernelsX.cu >> tmp_spectral_kernels_dp_%%G.cu
nvcc.exe -o tmp_spectral_kernels_dp_%%G.ptx -ptx -arch compute_60 -I../../.. -DCUDA -DCUDA_SPECTRAL -O3 -m64 tmp_spectral_kernels_dp_%%G.cu || exit /b 1

)

set OUTFILE="BeagleCUDASpectral_kernels.h"

echo // auto-generated header file with CUDA spectral kernels code > %OUTFILE%

echo #ifndef __BeagleCUDASpectral_kernels__ >> %OUTFILE%
echo #define __BeagleCUDASpectral_kernels__ >> %OUTFILE%

FOR %%G IN (4 16 32 48 64 80 128 192 256) DO (

..\..\..\project\beagle-vs-2019-wix\bin2c.exe -p 0 -st -n KERNELS_STRING_SP_%%G tmp_spectral_kernels_sp_%%G.ptx >> %OUTFILE%
..\..\..\project\beagle-vs-2019-wix\bin2c.exe -p 0 -st -n KERNELS_STRING_DP_%%G tmp_spectral_kernels_dp_%%G.ptx >> %OUTFILE%

)

echo #endif 	// __BeagleCUDASpectral_kernels__ >> %OUTFILE%

del tmp_spectral_kernels*
